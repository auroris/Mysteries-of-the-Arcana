---
layout: base.njk
permalink: index.html
---

{% set latestComic = collections.comics | reverse | first %}
{% set latestPost = collections.posts | reverse | first %}

<div class="hide-mobile">{% include "comic-nav.njk" %}</div>

<div class="content-h">
    {% include "site-nav.njk" %}
    <div class="comic-page-layout">
        <article class="comic">
            {% ComicImage "content/comics/" + latestComic.fileSlug, latestComic.data.alt %}
        </article>

        {% if latestComic.templateContent | trim %}
        <section class="comic-transcript" aria-labelledby="comic-transcript-title">
            <h2 id="comic-transcript-title">Transcript</h2>
            <div class="comic-transcript-body">
                {{ latestComic.templateContent | safe }}
            </div>
        </section>
        {% endif %}
    </div>
</div>

{% include "comic-nav.njk" %}

<div class="content-v">
    <article class="post frontpage">
        <h1 class="posttitle">{{ latestPost.data.title }}</h1>
        <div class="postmeta">Published on: <span class="date">{{ latestPost.date | date() }}</span> | Author: <span class="author">{{ latestPost.data.author }}</span></div>
        <div class="post-content">
            {{ latestPost.templateContent | safe }}
        </div>
    </article>
</div>
